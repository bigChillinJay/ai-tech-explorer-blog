{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/chart-annotation.schema.json",
  "title": "ChartAnnotation",
  "type": "object",
  "required": ["version", "chart", "layers"],
  "properties": {
    "version": { "type": "string", "description": "Annotation schema/version string, e.g. 1.0" },
    "chart": {
      "type": "object",
      "required": ["symbol", "interval"],
      "properties": {
        "symbol": { "type": "string" },
        "interval": { "type": "string", "description": "e.g. 1m, 5m, 15m, 1h, 4h, 1D" },
        "exchange": { "type": "string" },
        "timezone": { "type": "string", "default": "UTC" },
        "priceScale": { "type": "number", "description": "Optional number of price decimals" }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "author": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" },
        "source": { "type": "string", "description": "Link or slug of original chart" }
      }
    },
    "tradeIdea": {
      "type": "object",
      "required": ["bias"],
      "properties": {
        "bias": { "type": "string", "enum": ["long", "short", "neutral"] },
        "setup": { "type": "string" },
        "entry": { "type": "number" },
        "stop": { "type": "number" },
        "targets": { "type": "array", "items": { "type": "number" } },
        "rr": { "type": "number", "description": "Risk-reward ratio if provided" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "style": {
      "type": "object",
      "properties": {
        "theme": { "type": "string", "enum": ["light", "dark"], "default": "dark" },
        "palette": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "hline",
              "vline",
              "box",
              "line",
              "arrow",
              "path",
              "channel",
              "fibonacci",
              "sessionDivider",
              "volumeProfile",
              "rrBox"
            ]
          },
          "timeframe": { "type": "string", "description": "Optional: element scoped timeframe" },
          "style": {
            "type": "object",
            "properties": {
              "color": { "type": "string" },
              "fill": { "type": "string" },
              "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
              "width": { "type": "number" },
              "dash": { "type": "string", "enum": ["solid", "dash", "dot", "dashdot"] },
              "zIndex": { "type": "number" }
            }
          },
          "data": { "type": "object", "description": "Geometry and type-specific payload" }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "hline" } } },
            "then": { "properties": { "data": { "properties": { "price": { "type": "number" } }, "required": ["price"] } } }
          },
          {
            "if": { "properties": { "type": { "const": "vline" } } },
            "then": { "properties": { "data": { "properties": { "time": { "type": "string", "format": "date-time" } }, "required": ["time"] } } }
          },
          {
            "if": { "properties": { "type": { "const": "box" } } },
            "then": { "properties": { "data": { "properties": { "x1": { "type": "string", "format": "date-time" }, "x2": { "type": "string", "format": "date-time" }, "y1": { "type": "number" }, "y2": { "type": "number" } }, "required": ["x1", "x2", "y1", "y2"] } } }
          },
          {
            "if": { "properties": { "type": { "const": "line" } } },
            "then": { "properties": { "data": { "properties": { "x1": { "type": "string", "format": "date-time" }, "y1": { "type": "number" }, "x2": { "type": "string", "format": "date-time" }, "y2": { "type": "number" } }, "required": ["x1", "y1", "x2", "y2"] } } }
          },
          {
            "if": { "properties": { "type": { "const": "arrow" } } },
            "then": { "properties": { "data": { "properties": { "x1": { "type": "string", "format": "date-time" }, "y1": { "type": "number" }, "x2": { "type": "string", "format": "date-time" }, "y2": { "type": "number" } }, "required": ["x1", "y1", "x2", "y2"] } } }
          },
          {
            "if": { "properties": { "type": { "const": "channel" } } },
            "then": { "properties": { "data": { "properties": { "x1": { "type": "string", "format": "date-time" }, "y1": { "type": "number" }, "x2": { "type": "string", "format": "date-time" }, "y2": { "type": "number" } }, "required": ["x1", "y1", "x2", "y2"] } } }
          },
          {
            "if": { "properties": { "type": { "const": "fibonacci" } } },
            "then": { "properties": { "data": { "properties": { "x1": { "type": "string", "format": "date-time" }, "y1": { "type": "number" }, "x2": { "type": "string", "format": "date-time" }, "y2": { "type": "number" }, "levels": { "type": "array", "items": { "type": "object", "properties": { "level": { "type": "number" }, "label": { "type": "string" } }, "required": ["level"] } } }, "required": ["x1", "y1", "x2", "y2"] } } }
          },
          {
            "if": { "properties": { "type": { "const": "sessionDivider" } } },
            "then": { "properties": { "data": { "properties": { "time": { "type": "string", "format": "date-time" }, "label": { "type": "string" } }, "required": ["time"] } } }
          },
          {
            "if": { "properties": { "type": { "const": "volumeProfile" } } },
            "then": { "properties": { "data": { "properties": { "from": { "type": "string", "format": "date-time" }, "to": { "type": "string", "format": "date-time" }, "rows": { "type": "number" } }, "required": ["from", "to"] } } }
          },
          {
            "if": { "properties": { "type": { "const": "rrBox" } } },
            "then": { "properties": { "data": { "properties": { "side": { "type": "string", "enum": ["long", "short"] }, "entry": { "type": "number" }, "stop": { "type": "number" }, "target": { "type": "number" } }, "required": ["side", "entry", "stop", "target"] } } }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}

